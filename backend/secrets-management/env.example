# DevOps Secrets Management - Environment Configuration
# Author: Adrian Johnson <adrian207@gmail.com>
# Copy this file to .env and update with your values

# ============================================================================
# APPLICATION
# ============================================================================
ENVIRONMENT=development
DEBUG=true
ENABLE_DOCS=true

# ============================================================================
# API SERVER
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8001

# ============================================================================
# DATABASE
# ============================================================================
# Use existing Vaultwarden database or create separate database
DATABASE_URL=postgresql://vaultwarden:password@localhost:5432/vaultwarden
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_ECHO=false

# ============================================================================
# SECURITY
# ============================================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-change-me

# API Key Configuration
API_KEY_LENGTH=32
API_KEY_PREFIX=vw_svc_
API_KEY_SALT=your-salt-here-change-me

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Password/Key Hashing
BCRYPT_ROUNDS=12

# Encryption Key for secrets
# Generate with: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=your-encryption-key-here-change-me

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_SECOND=100
RATE_LIMIT_BURST=200

# Optional: Redis for distributed rate limiting
# REDIS_URL=redis://localhost:6379/0

# ============================================================================
# CORS
# ============================================================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8001

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
# Optional: Write logs to file
# LOG_FILE=/var/log/secrets-api.log

# ============================================================================
# ROTATION
# ============================================================================
ROTATION_ENABLED=true
# Check for due rotations every N seconds (300 = 5 minutes)
ROTATION_SCHEDULER_INTERVAL=300

# ============================================================================
# INTEGRATIONS
# ============================================================================

# Vaultwarden Integration
VAULTWARDEN_URL=http://localhost:80
# Optional: Admin token for Vaultwarden API
# VAULTWARDEN_ADMIN_TOKEN=your-admin-token

# GitHub Actions (optional)
# GITHUB_APP_ID=your-app-id
# GITHUB_PRIVATE_KEY=your-private-key

# GitLab CI (optional)
# GITLAB_URL=https://gitlab.com
# GITLAB_TOKEN=your-gitlab-token

# Kubernetes (optional)
K8S_IN_CLUSTER=false
# K8S_CONFIG_FILE=~/.kube/config

# ============================================================================
# MONITORING
# ============================================================================
METRICS_ENABLED=true
PROMETHEUS_PORT=9090

# ============================================================================
# AUDIT
# ============================================================================
# Keep audit logs for 365 days
AUDIT_LOG_RETENTION_DAYS=365

# ============================================================================
# FEATURE FLAGS
# ============================================================================
FEATURE_SECRET_VERSIONING=true
FEATURE_AUTOMATIC_ROTATION=true
FEATURE_DYNAMIC_SECRETS=false

# ============================================================================
# DEVELOPMENT ONLY
# ============================================================================
# Uncomment for development environment

# Enable SQL query logging
# DB_ECHO=true

# Disable rate limiting for testing
# RATE_LIMIT_ENABLED=false

